{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate --config ./src/prisma.config.ts && tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev --config ./src/prisma.config.ts",
    "db:generate": "prisma generate --config ./src/prisma.config.ts",
    "db:studio": "prisma studio --config ./src/prisma.config.ts",
    "db:push": "prisma db push --config ./src/prisma.config.ts",
    "db:reset": "prisma migrate reset --config ./src/prisma.config.ts",
    "db:seed": "prisma db seed --config ./src/prisma.config.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "gen:secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
  },
